---
import { windowsUrl } from '../lib/download'

interface Props {
    title: string
    description?: string
    ogImage?: string
}

const {
    title,
    description = 'A fast, minimal image viewer for macOS. Instant display, GPU-accelerated img display, accurate colors, RAW support, background preloading. Built in Rust, blazing fast.',
    ogImage = '/og-default.png',
} = Astro.props
---

<!doctype html>
<!-- `data-has-windows-build` tells the OS-detection script below whether this release actually
     shipped an installer. Without it, a Windows visitor would land on a button with no label. -->
<html lang="en" data-has-windows-build={windowsUrl ? '' : undefined}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content={description} />
        <meta name="theme-color" content="#0f1419" media="(prefers-color-scheme: dark)" />
        <meta name="theme-color" content="#f8fafb" media="(prefers-color-scheme: light)" />
        <meta name="color-scheme" content="dark light" />

        <!-- Open Graph -->
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={Astro.url.href} />
        {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.site).href} />}

        <!-- Twitter -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        {ogImage && <meta name="twitter:image" content={new URL(ogImage, Astro.site).href} />}

        <!-- Favicon -->
        <link rel="icon" href="/favicon.ico" sizes="32x32" />
        <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

        <!-- Preload self-hosted font for faster FCP -->
        <link rel="preload" as="font" type="font/woff2" href="/fonts/inter-latin-variable.woff2" crossorigin />

        <title>{title}</title>

        <!-- Organization structured data -->
        <script
            type="application/ld+json"
            set:html={JSON.stringify({
                '@context': 'https://schema.org',
                '@type': 'Organization',
                name: 'Prvw',
                url: 'https://getprvw.com',
                sameAs: ['https://github.com/vdavid/prvw'],
            })}
        />

        {/* Stamp the visitor's OS before first paint, so the download button never flashes the
            macOS wording at a Windows or Linux visitor. Leaving the attribute off means "macOS",
            which is where no-JS visitors and anyone we can't identify land. */}
        <script is:inline>
            ;(function () {
                var root = document.documentElement
                var uaData = navigator.userAgentData
                var ua = navigator.userAgent || ''
                var platform = (uaData && uaData.platform) || navigator.platform || ''

                // Phones and tablets run none of the builds, so they keep the macOS default.
                if ((uaData && uaData.mobile) || /Android|iPhone|iPad|iPod/i.test(ua)) return

                if (/Win/i.test(platform) || /Windows/i.test(ua)) {
                    // A release without an installer has no Windows label to show.
                    if (root.hasAttribute('data-has-windows-build')) root.dataset.os = 'windows'
                } else if (/Mac/i.test(platform) || /Mac OS X/i.test(ua)) {
                    root.dataset.os = 'macos'
                } else if (/Linux|X11|CrOS/i.test(platform) || /Linux|X11|CrOS/i.test(ua)) {
                    root.dataset.os = 'linux'
                }
            })()
        </script>

        {/* Apply persisted theme choice before first paint to prevent FOUC */}
        <script is:inline>
            ;(function () {
                try {
                    var t = localStorage.getItem('theme')
                    if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t
                } catch {
                    /* localStorage unavailable */
                }
            })()
        </script>
        <style is:inline>
            @media (prefers-color-scheme: light) {
                html:not([data-theme='dark']) {
                    background-color: #f8fafb;
                }
            }
            html[data-theme='light'] {
                background-color: #f8fafb;
            }
            html[data-theme='dark'] {
                background-color: #0f1419;
            }
        </style>

        {/* Umami analytics: self-hosted, cookieless */}
        {
            import.meta.env.PUBLIC_UMAMI_WEBSITE_ID && (
                <script
                    defer
                    src={`${import.meta.env.PUBLIC_UMAMI_HOST}/mami`}
                    data-website-id={import.meta.env.PUBLIC_UMAMI_WEBSITE_ID}
                />
            )
        }

        {/* PostHog session replay, cookieless (persistence: memory, no cookies) */}
        {
            import.meta.env.PUBLIC_POSTHOG_KEY && (
                <script
                    is:inline
                    src="/scripts/posthog-init.js"
                    data-ph-key={import.meta.env.PUBLIC_POSTHOG_KEY}
                    data-ph-host={import.meta.env.PUBLIC_POSTHOG_HOST || 'https://eu.i.posthog.com'}
                />
            )
        }
    </head>
    <body class="min-h-screen">
        <slot />

        <script is:inline>
            ;(function () {
                var os = document.documentElement.dataset.os || 'macos'

                // Point the button at the Windows installer. The CSS in `DownloadButton.astro`
                // already swapped the label; this is the href and the analytics props.
                function applyWindows() {
                    document.querySelectorAll('a[data-download-link]').forEach(function (el) {
                        if (!el.dataset.winUrl) return
                        el.href = el.dataset.winUrl
                        el.setAttribute('data-umami-event-platform', 'windows')
                        el.setAttribute('data-umami-event-arch', 'x86_64')
                    })

                    document.querySelectorAll('[data-download-dropdown] [data-platform="windows"]').forEach(function (el) {
                        el.dataset.recommended = 'true'
                    })
                }

                // There's no Linux build, so the button opens the repo instead of a download that
                // doesn't exist. The dropdown still offers the macOS and Windows builds.
                function applyLinux() {
                    document.querySelectorAll('a[data-download-link]').forEach(function (el) {
                        if (el.dataset.sourceUrl) el.href = el.dataset.sourceUrl
                        el.setAttribute('target', '_blank')
                        el.setAttribute('rel', 'noopener noreferrer')
                        el.setAttribute('data-umami-event', 'build-from-source')
                        el.setAttribute('data-umami-event-platform', 'linux')
                        el.removeAttribute('data-umami-event-arch')
                    })
                }

                function applyArch(arch) {
                    var label = arch === 'aarch64' ? 'Apple Silicon' : 'Intel'

                    document.querySelectorAll('a[data-download-link]').forEach(function (el) {
                        var url = arch === 'aarch64' ? el.dataset.dmgArm : el.dataset.dmgIntel
                        if (url) el.href = url
                        el.setAttribute('data-umami-event-arch', arch)
                        var size = arch === 'aarch64' ? el.dataset.sizeArm : el.dataset.sizeIntel
                        if (size) {
                            el.querySelectorAll('[data-download-size]').forEach(function (s) {
                                s.textContent = ' · ' + size
                            })
                        }
                    })

                    document.querySelectorAll('[data-download-arch-hint]').forEach(function (el) {
                        el.textContent = label + ' detected'
                    })

                    document.querySelectorAll('[data-download-dropdown] [data-arch]').forEach(function (el) {
                        if (el.dataset.arch === arch) {
                            el.dataset.recommended = 'true'
                        }
                    })
                }

                // Detect arch synchronously via WebGL renderer string.
                // "Apple M1/M2/GPU" on Apple Silicon, "Intel/AMD" on Intel Macs.
                // Falls back to localStorage cache from a previous async detection.
                function detectArchSync() {
                    try {
                        var canvas = document.createElement('canvas')
                        var gl = canvas.getContext('webgl')
                        if (!gl) return null
                        var ext = gl.getExtension('WEBGL_debug_renderer_info')
                        if (!ext) return null
                        var renderer = gl.getParameter(ext.UNMASKED_RENDERER_WEBGL)
                        if (/Apple M|Apple GPU/.test(renderer)) return 'aarch64'
                        if (/Intel|AMD/.test(renderer)) return 'x86_64'
                    } catch { /* WebGL unavailable */ }
                    return null
                }

                if (os === 'windows') {
                    applyWindows()
                    return
                }
                if (os === 'linux') {
                    applyLinux()
                    return
                }

                // Everything below is macOS only. The WebGL renderer string reads "Intel" or "AMD"
                // on a Windows PC too, so running it off-macOS would recommend an arch nobody asked
                // for and quietly overwrite the href we just set.
                var syncArch = detectArchSync()
                if (!syncArch) {
                    try {
                        syncArch = localStorage.getItem('prvw-arch')
                    } catch {
                        /* localStorage unavailable */
                    }
                }
                if (syncArch) applyArch(syncArch)

                // Detect arch async and update cache for next visit
                if (!navigator.userAgentData) return
                navigator.userAgentData
                    .getHighEntropyValues(['architecture'])
                    .then(function (ua) {
                        var arch = ua.architecture === 'arm' ? 'aarch64' : ua.architecture === 'x86' ? 'x86_64' : null
                        if (!arch) return
                        try {
                            localStorage.setItem('prvw-arch', arch)
                        } catch {
                            /* localStorage unavailable */
                        }
                        applyArch(arch)
                    })
                    .catch(function () {})
            })()
        </script>
    </body>
</html>

<style is:global>
    @import '../styles/global.css';
</style>
