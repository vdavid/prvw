<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  The application manifest Windows reads before any of our code runs, which is why none of this
  can be an API call at startup. `build.rs` embeds it as RT_MANIFEST resource 1 and substitutes
  __VERSION__, the same placeholder `Info.plist` uses on macOS.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity type="win32" name="Rymdskottkarra.Prvw" version="__VERSION__" processorArchitecture="*" />

  <!--
    Without this, comctl32 v5 is what loads: unthemed controls, no task dialogs, no SysLink. Every
    native widget the Windows UI design picks assumes v6.
  -->
  <dependency>
    <dependentAssembly>
      <assemblyIdentity type="win32" name="Microsoft.Windows.Common-Controls" version="6.0.0.0"
        processorArchitecture="*" publicKeyToken="6595b64144ccf1df" language="*" />
    </dependentAssembly>
  </dependency>

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <!-- A viewer never needs elevation, and saying so turns off UAC's installer heuristics. -->
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!--
        Windows 10 and 11 share this GUID. It's the only one we claim: the support floor is
        Windows 10 22H2, and an older Windows should get its compatibility shims rather than
        pretend we tested there.
      -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!--
        Per-monitor v2: the app scales itself on every monitor, including the non-client area and
        comctl32's theme assets. `dpiAware` is the Windows 8.1 spelling, kept as the fallback for
        anything that doesn't read the 2016 one.
      -->
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
      <!-- Lifts MAX_PATH, so a deep photo library on a NAS still opens. -->
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
      <!-- Makes the ANSI Win32 and CRT entry points speak UTF-8, so a C dependency can't mangle a path. -->
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
