; Prvw's file-type registration, for the installer and its uninstaller.
;
; GENERATED by `cargo xtask installer-registry` from `settings::windows::file_types`. Don't edit
; it by hand: `./scripts/check.sh --check installer` rewrites it and fails in CI when the two
; disagree. Add a format to `decoding::dispatch` and it appears here.
;
; Every key is under HKCU, so the installer needs no elevation, and nothing here touches
; `UserChoice`: since Windows 10 20H2 only the user can pick a default handler. What these keys
; buy is a place in Explorer's "Open with" list and a page of Prvw's own in Settings.

!macro PrvwRegisterFileTypes
  WriteRegStr HKCU "Software\Classes\Prvw.Image" "" "Image"
  WriteRegStr HKCU "Software\Classes\Prvw.Image\DefaultIcon" "" "$INSTDIR\prvw.exe,0"
  WriteRegStr HKCU "Software\Classes\Prvw.Image\shell\open\command" "" '"$INSTDIR\prvw.exe" "%1"'
  WriteRegStr HKCU "Software\Classes\Applications\prvw.exe" "FriendlyAppName" "Prvw"
  WriteRegStr HKCU "Software\Classes\Applications\prvw.exe\shell\open\command" "" '"$INSTDIR\prvw.exe" "%1"'
  WriteRegStr HKCU "Software\Prvw\Capabilities" "ApplicationName" "Prvw"
  WriteRegStr HKCU "Software\Prvw\Capabilities" "ApplicationDescription" "A fast, minimal image viewer."
  WriteRegStr HKCU "Software\Prvw\Capabilities" "ApplicationIcon" "$INSTDIR\prvw.exe,0"
  WriteRegStr HKCU "Software\Classes\.arw\OpenWithProgids" "Prvw.Image" ""
  WriteRegStr HKCU "Software\Classes\Applications\prvw.exe\SupportedTypes" ".arw" ""
  WriteRegStr HKCU "Software\Prvw\Capabilities\FileAssociations" ".arw" "Prvw.Image"
  WriteRegStr HKCU "Software\Classes\.bmp\OpenWithProgids" "Prvw.Image" ""
