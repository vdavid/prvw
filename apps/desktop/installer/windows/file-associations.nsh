  WriteRegStr HKCU "Software\Classes\.webp\OpenWithProgids" "Prvw.Image" ""
  WriteRegStr HKCU "Software\Classes\Applications\prvw.exe\SupportedTypes" ".webp" ""
  WriteRegStr HKCU "Software\Prvw\Capabilities\FileAssociations" ".webp" "Prvw.Image"
  WriteRegStr HKCU "Software\RegisteredApplications" "Prvw" "Software\Prvw\Capabilities"
!macroend

